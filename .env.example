# Build Room environment variables — names only, never values.
# Real values live in the deployment platform's encrypted secret store.
# See repository-security-standard.md §1.

# Railway (control plane)
# RAILWAY_TOKEN=

# Neon (Postgres)
# DATABASE_URL=

# Cloudflare (web app)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Provider API keys (per DEC-20260815-04, DEC-20260815-07)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
