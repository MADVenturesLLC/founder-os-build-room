# Build Room environment variables — names only, never values.
# Real values live in the deployment platform's encrypted secret store.
# See repository-security-standard.md §1.

# --- Control plane (packages/control-plane) — required ---
# DATABASE_URL=            # postgres:// or postgresql://; Neon-hosted Postgres
# CONTROL_PLANE_TOKEN=     # shared secret for room endpoints, >= 32 chars

# --- Control plane — optional (defaults documented in packages/control-plane/README.md) ---
# PHASE3_ADJUDICATION_TOKEN=   # Founder-only Phase 3 pass/fail adjudication; unset = route absent
# PORT=
# RAILWAY_GIT_COMMIT_SHA=      # or COMMIT_SHA
# RAILWAY_ENVIRONMENT_NAME=    # or NODE_ENV
# READY_PROBE_TIMEOUT_MS=
# STATEMENT_TIMEOUT_MS=
# PG_POOL_MAX=
# PG_POOL_IDLE_TIMEOUT_MS=
# PG_CONNECTION_TIMEOUT_MS=
# GATEWAY_CODE_TTL_MS= / GATEWAY_HEARTBEAT_CADENCE_MS= / GATEWAY_STALENESS_MS= / GATEWAY_TIMESTAMP_WINDOW_MS= / GATEWAY_AWAITING_APPROVAL_TTL_MS=
# LEADER_HEARTBEAT_MS= / LEADER_LEASE_TTL_MS= / LEADER_SAFETY_DEADLINE_MS= / CHALLENGE_ROTATION_MS=
# SESSION_NONCE_CAPACITY= / CLOCK_BACKWARD_TOLERANCE_MS= / CLOCK_DIVERGENCE_TOLERANCE_MS= / CLOCK_STABILITY_MS=
# SWEEP_INTERVAL_MS= / TRUST_PROXY_HOPS=

# --- Run harness (packages/run-harness) — Phase 2 gate ---
# CONTROL_PLANE_URL=       # the deployed control plane (run harness client, not the server config above)
# PHASE2_RUNS= / PHASE2_DWELL_MS= / PHASE2_RESTART_COMMAND= / PHASE2_EVIDENCE_PATH=
# PHASE2_ACTOR_ID= / PHASE2_ACTUAL_MODEL= / PHASE2_ROLE_ID= / PHASE2_EXECUTION_SURFACE= / PHASE2_ENVIRONMENT=

# --- Run harness — Phase 3 counted-run (packages/run-harness/src/phase3) ---
# PHASE3_BUILD_VERIFIED_SHA=
# PHASE3_PLAN_PATH=        # absolute path to nonsecret JSON plan
# PHASE3_EVIDENCE_PATH=    # absolute private directory outside FounderOS/Build Room/fixture repos

# --- Gateway daemon / CLI (packages/gateway-daemon, packages/gateway-cli) ---
# BUILDROOM_CONTROL_PLANE_URL=   # default http://127.0.0.1:8080

# --- Railway (control-plane restart script, scripts/railway-restart.sh) ---
# RAILWAY_API_TOKEN=       # Railway PROJECT token, scoped to one project+environment; never CI-persisted
# RAILWAY_PROJECT_ID=
# RAILWAY_SERVICE_ID=
# RAILWAY_ENVIRONMENT_ID=
# RAILWAY_API_URL=         # optional override, defaults to Railway's GraphQL v2 endpoint

# --- Deferred / not yet consumed by any runtime code in this repository ---
# The web tier (Cloudflare Workers) is deferred (DEC-20260815-08); nothing
# reads these today. Listed for forward reference only.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Provider API keys (per DEC-20260815-04, DEC-20260815-07) — no dispatch
# code exists yet in this repository; these are not read by any current
# runtime path. Listed for forward reference only.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
