{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "types": [
      "node"
    ],
    "composite": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "packages/contracts/src/**/*.ts",
    "packages/ledger/src/**/*.ts",
    "packages/control-plane/src/**/*.ts",
    "packages/cost-meter/src/**/*.ts",
    "test/**/*.ts"
  ]
}
